# ── Hetzner deployment environment variables ───────────────────────────────
# Copy this to .env and fill in real values before running docker compose.
#
# Usage:
#   cp .env.hetzner.example .env
#   nano .env
#   docker compose -f docker-compose.hetzner.yml --env-file .env up -d

# RunPod Ollama public URL (get this from your RunPod pod's "Connect" page)
# Format: https://<pod-id>-11434.proxy.runpod.net
OLLAMA_HOST=https://REPLACE_WITH_RUNPOD_POD_ID-11434.proxy.runpod.net

# LLM model used for quiz generation (must be pulled in RunPod)
QUIZ_LLM_MODEL=phi3:mini

# PostgreSQL credentials (change password in production!)
POSTGRES_DB=linguist
POSTGRES_USER=linguist
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# pgAdmin web UI credentials
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET

# Hugging Face token (optional, for embedding models)
HF_TOKEN=
